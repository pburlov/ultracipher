# Lokale SDK-Pfade, geraetespezifisch
local.properties

# IDE-Metadaten (IntelliJ/Android Studio)
.idea/
*.iml

# Generierte Flutter-Plugin-Liste
.flutter-plugins-dependencies

# macOS-Finder-Metadaten
.DS_Store
.flutter-plugins

# Build-Ausgaben und Dart-Cache
build/
.dart_tool/

# Firebase: die Projekt-ID kommt aus der Repo-Variable FIREBASE_PROJECT_ID,
# nicht aus einer eingecheckten .firebaserc
.firebaserc
.firebase/
firebase-debug.log
node_modules/

# Sync-Server (Firebase): Konfiguration pro Projekt (`.env.<projekt-id>`, enthaelt
# den geheimen Pfadpraefix); nur die Vorlage wird eingecheckt
server/firebase/functions/.env*
!server/firebase/functions/.env.example
